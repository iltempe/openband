{
  "name": "openband",
  "version": "0.3.0",
  "description": "Open-source GarageBand-style music studio for the browser, controllable by AI through MCP",
  "keywords": [
    "daw",
    "music",
    "web-audio",
    "mcp",
    "garageband"
  ],
  "homepage": "https://iltempe.github.io/openband/",
  "bugs": {
    "url": "https://github.com/iltempe/openband/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iltempe/openband.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "openband": "bin/openband.mjs"
  },
  "files": [
    "dist",
    "bin",
    "server/*.mjs",
    "README.md",
    "README.it.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mcp": "node bin/openband.mjs mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:song": "node scripts/openband-lint.mjs",
    "start": "node bin/openband.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs",
    "smoke:mcpb": "node scripts/smoke-mcpb.mjs",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@webaudiomodules/sdk": "^0.0.12",
    "@xmldom/xmldom": "^0.8.10",
    "esbuild": "^0.21.5",
    "fflate": "^0.8.2",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "zustand": "^4.5.5"
  }
}
