{
  "name": "openband",
  "version": "0.1.0",
  "description": "Open-source GarageBand-style music studio for the browser, controllable by AI through MCP",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mcp": "node server/mcp-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "daw",
    "music",
    "web-audio",
    "mcp",
    "garageband"
  ],
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "license": "MIT"
}
