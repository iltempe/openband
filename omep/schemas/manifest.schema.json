{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openband.dev/omep/1.0/manifest.schema.json",
  "title": "OMEP 1.0 engine manifest (resource omep://manifest)",
  "type": "object",
  "required": ["omep", "engine", "license", "runtime", "capabilities", "outputs", "determinism"],
  "properties": {
    "omep": { "const": "1.0" },
    "engine": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "license": { "$ref": "#/$defs/license" },
    "runtime": {
      "type": "object",
      "required": ["where"],
      "properties": {
        "where": { "enum": ["builtin", "browser", "local", "lan", "cloud"] },
        "device": { "type": "array", "items": { "enum": ["cpu", "cuda", "mps", "rocm", "webgpu", "wasm"] } },
        "vram_gb": { "type": "number", "minimum": 0 },
        "realtime": { "type": "boolean" },
        "provider": { "type": "string" },
        "pricing": {
          "type": "object",
          "required": ["unit", "usd"],
          "properties": {
            "unit": { "enum": ["second", "minute", "call", "track", "1k_tokens"] },
            "usd": { "type": "number", "minimum": 0 },
            "verified": { "type": "string", "format": "date" }
          },
          "additionalProperties": false
        },
        "data_policy": {
          "type": "object",
          "required": ["uploads_audio", "training_on_inputs", "terms_url", "verified"],
          "properties": {
            "uploads_audio": { "type": "boolean" },
            "retention": { "type": "string" },
            "training_on_inputs": { "enum": ["no", "yes", "unknown"] },
            "terms_url": { "type": "string", "format": "uri" },
            "verified": { "type": "string", "format": "date" }
          },
          "additionalProperties": false
        },
        "output_rights": {
          "type": "object",
          "required": ["commercial"],
          "properties": {
            "commercial": { "enum": ["yes", "no", "conditional"] },
            "terms_url": { "type": "string", "format": "uri" },
            "plan": { "type": "string", "description": "The user's plan with the provider, when the rights depend on it" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        { "if": { "properties": { "where": { "const": "cloud" } } }, "then": { "required": ["provider", "pricing", "data_policy", "output_rights"] } }
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(music\\.(song|add_layer|repaint|extend|restyle|arrange)|symbolic\\.(continue|harmonize|accompany|drums)|voice\\.sing|audio\\.(separate|transcribe|match_sound)|mix\\.assist|stream\\.jam|x-[a-z0-9-]+\\.[a-z0-9_.-]+)$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "conditioning": { "type": "array", "uniqueItems": true, "items": { "enum": ["bpm", "key", "meter", "chords", "sections", "melody", "lyrics", "phonemes", "context_audio", "stems", "text", "references", "range", "energy"] } },
          "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "max_variants": { "type": "integer", "minimum": 1 },
          "roles": { "type": "array", "items": { "type": "string" } },
          "experimental": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "outputs": { "type": "array", "minItems": 1, "items": { "enum": ["audio/wav", "audio/flac", "audio/ogg", "audio/mpeg", "application/x-omep-notes", "application/x-omep-params", "application/x-omep-stream"] } },
    "languages": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$" } },
    "determinism": { "enum": ["seeded", "stochastic", "deterministic"] },
    "voices": {
      "description": "Voicebanks or presets with licences of their own (voice.sing).",
      "type": "array",
      "items": { "type": "object", "required": ["id", "license"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "language": { "type": "string" }, "license": { "$ref": "#/$defs/license" } }, "additionalProperties": false }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "license": {
      "type": "object",
      "required": ["code", "weights", "commercial"],
      "properties": {
        "code": { "type": "string" },
        "weights": { "type": ["string", "null"] },
        "commercial": { "enum": ["yes", "no", "conditional"] },
        "attribution": { "type": ["string", "null"] },
        "conditions": { "type": ["string", "null"] },
        "url": { "type": "string", "format": "uri" }
      },
      "allOf": [
        { "if": { "properties": { "commercial": { "const": "conditional" } } }, "then": { "required": ["conditions"], "properties": { "conditions": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "weights": { "type": "string", "pattern": "CC[- ]BY" } } }, "then": { "required": ["attribution"], "properties": { "attribution": { "type": "string", "minLength": 1 } } } }
      ],
      "additionalProperties": false
    }
  }
}
